{
  "openapi": "3.1.0",
  "info": {
    "title": "Ship Public API",
    "version": "1.0.0",
    "description": "The Ship platform public API. All routes live under /api/v1/. Authentication uses OAuth 2.0 Bearer tokens. Versioning policy: additive changes only in /v1/; breaking changes via /v2/."
  },
  "servers": [
    {
      "url": "https://ship-api-ysxi.onrender.com/api/v1",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["unauthorized", "forbidden", "not_found", "validation_failed", "rate_limited", "server_error"]
          },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": {} },
          "request_id": { "type": "string", "format": "uuid" }
        },
        "required": ["code", "message", "request_id"]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "document_type": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid Bearer token",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Forbidden": {
        "description": "Insufficient scope",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "ValidationFailed": {
        "description": "Request body validation failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    }
  },
  "paths": {
    "/docs": {
      "get": {
        "operationId": "listDocuments",
        "summary": "List documents",
        "description": "Returns a cursor-paginated list of documents visible to the authenticated user.",
        "security": [{ "bearerAuth": ["documents:read"] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Opaque cursor returned by a previous list call."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Document" } },
                    "next_cursor": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createDocument",
        "summary": "Create document",
        "security": [{ "bearerAuth": ["documents:write"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "document_type": {
                    "type": "string",
                    "enum": ["wiki", "issue", "program", "project", "sprint", "person"],
                    "default": "wiki"
                  },
                  "content": {},
                  "properties": { "type": "object", "additionalProperties": {} }
                },
                "required": ["title"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Document created" },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/docs/{id}": {
      "get": {
        "operationId": "getDocument",
        "summary": "Get document by ID",
        "security": [{ "bearerAuth": ["documents:read"] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get current authenticated user",
        "description": "Returns the user associated with the current token. Client Credentials tokens return 403 — they have no user identity.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "email": { "type": "string" },
                    "granted_scopes": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/webhooks": {
      "post": {
        "operationId": "createWebhook",
        "summary": "Register a webhook subscription",
        "description": "Creates a per-app webhook subscription. The signing_secret is returned once and never recoverable thereafter.",
        "security": [{ "bearerAuth": ["webhooks:manage"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_url": { "type": "string", "format": "uri" },
                  "event_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "document.created", "document.updated", "document.deleted",
                        "issue.created", "issue.assigned", "issue.status_changed",
                        "sprint.started", "sprint.completed"
                      ]
                    }
                  }
                },
                "required": ["target_url", "event_types"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created. signing_secret shown once — store it immediately.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "target_url": { "type": "string" },
                    "event_types": { "type": "array", "items": { "type": "string" } },
                    "signing_secret": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "get": {
        "operationId": "listWebhooks",
        "summary": "List webhook subscriptions",
        "security": [{ "bearerAuth": ["webhooks:manage"] }],
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array" },
                    "next_cursor": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/webhooks/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
        "summary": "List webhook delivery attempts",
        "description": "Returns all delivery attempts for the authenticated app, including retries and dead-lettered entries.",
        "security": [{ "bearerAuth": ["webhooks:manage"] }],
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/webhooks/deliveries/{id}/replay": {
      "post": {
        "operationId": "replayWebhookDelivery",
        "summary": "Replay a webhook delivery",
        "description": "Re-fires the delivery with the original Idempotency-Key so subscribers can deduplicate correctly.",
        "security": [{ "bearerAuth": ["webhooks:manage"] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Replay queued" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
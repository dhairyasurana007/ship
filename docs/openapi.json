{
  "openapi": "3.1.0",
  "info": {
    "title": "Ship Public API",
    "version": "1.0.0"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/docs": {
      "get": {
        "operationId": "listDocuments",
        "summary": "List documents",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "documents:read"
            ]
          }
        ]
      },
      "post": {
        "operationId": "createDocument",
        "summary": "Create document",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "documents:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "document_type": {
                    "type": "string",
                    "enum": [
                      "wiki",
                      "issue",
                      "program",
                      "project",
                      "sprint",
                      "person"
                    ],
                    "default": "wiki"
                  },
                  "content": {},
                  "properties": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/docs/{id}": {
      "get": {
        "operationId": "getDocument",
        "summary": "Get document by ID",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "documents:read"
            ]
          }
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get current authenticated user",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/apps": {
      "post": {
        "operationId": "createOAuthApp",
        "summary": "Create an OAuth application",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "operationId": "getOAuthApp",
        "summary": "Get an OAuth application",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/apps/{id}/rotate": {
      "post": {
        "operationId": "rotateOAuthAppSecret",
        "summary": "Rotate an OAuth app secret",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/webhooks": {
      "post": {
        "operationId": "createWebhook",
        "summary": "Register a webhook subscription",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "webhooks:manage"
            ]
          }
        ]
      },
      "get": {
        "operationId": "listWebhooks",
        "summary": "List webhook subscriptions",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "webhooks:manage"
            ]
          }
        ]
      }
    },
    "/webhooks/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
        "summary": "List webhook delivery attempts",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "webhooks:manage"
            ]
          }
        ]
      }
    },
    "/webhooks/deliveries/{id}/replay": {
      "post": {
        "operationId": "replayWebhookDelivery",
        "summary": "Replay a webhook delivery",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "webhooks:manage"
            ]
          }
        ]
      }
    },
    "/audit": {
      "get": {
        "operationId": "listAuditTrail",
        "summary": "List public API audit trail entries",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "webhooks:manage"
            ]
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "Get the public OpenAPI document",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getPublicHealth",
        "summary": "Get public API health",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  }
}
